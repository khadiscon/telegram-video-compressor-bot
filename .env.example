# Required — from @BotFather
BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — your Telegram numeric user id (enables /admin /ban /unban)
OWNER_ID=

# Max videos encoded at once
MAX_CONCURRENT_JOBS=2

# Temporary encode workspace
# TEMP_DIR=/var/tmp/tg_video_compressor

# Persistent user settings / stats
# DATA_DIR=./data

# Only these user ids may use the bot (comma-separated). Requires PRIVATE_MODE=true
# PRIVATE_MODE=false
# ALLOWED_USER_IDS=

# Job timeout in seconds
# JOB_TIMEOUT_SEC=900

# Raise these when using a local Bot API server
# DOWNLOAD_LIMIT_MB=20
# UPLOAD_LIMIT_MB=50

# Local Bot API (files up to 2 GB). Also set TELEGRAM_LOCAL_API=true
# TELEGRAM_LOCAL_API=false
# TELEGRAM_API_URL=http://telegram-bot-api:8081
# TELEGRAM_FILE_URL=http://telegram-bot-api:8081

# Override binaries if they are not on PATH
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
