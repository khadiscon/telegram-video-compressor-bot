# Required
BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Your numeric Telegram user id (unlocks /admin /ban /unban)
OWNER_ID=

# Personal 500 MB defaults — set automatically when the local API starts
DOWNLOAD_LIMIT_MB=500
UPLOAD_LIMIT_MB=500
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_SEC=3600

# Lock the bot to you only
# PRIVATE_MODE=true
# ALLOWED_USER_IDS=
